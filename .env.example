# FiberTap API Configuration

# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fibertap

# CKB Network
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckbapp.dev/rpc
CKB_INDEXER_URL=https://testnet.ckbapp.dev/indexer

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Set to "true" to use MongoDB instead of in-memory storage
USE_MONGO=false
